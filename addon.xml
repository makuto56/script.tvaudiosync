<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tvaudiosync"
       name="TV Audio Sync"
       version="1.2.0"
       provider-name="tvaudiosync">
  <requires>
    <import addon="xbmc.python" version="2.26.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="default.py">
        <label>Commentaire audio (chaine en cours)</label>
        <visible>Pvr.IsPlayingTv</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="fr_FR">Ajoute un commentaire audio externe sur une chaine TV</summary>
    <description lang="fr_FR">Fusionne une chaine TV IPTV avec un flux audio externe.</description>
    <platform>linux</platform>
    <license>MIT</license>
  </extension>
</addon>
